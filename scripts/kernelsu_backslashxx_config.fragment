# KernelSU (backslashxx fork) + DroidSpace Config Fragment
# For Xiaomi MT6768 (lancelot/merlin/shiva) - Kernel 4.14
# backslashxx/KernelSU v3.2.5+

# =====================================================
# KernelSU (backslashxx fork) - Core
# =====================================================
# KSU depends on SECURITY_SELINUX (must be enabled in defconfig)
# KSU auto-selects SECCOMP
CONFIG_KSU=y

# kprobe-based early boot hooks (recommended)
CONFIG_KSU_KPROBES_KSUD=y

# Syscall table tampering for sucompat (recommended for < 4.17 kernels)
# Hooks: sys_reboot, sys_execve, sys_newfstatat, sys_faccessat, sys_newfstat, sys_read
CONFIG_KSU_TAMPER_SYSCALL_TABLE=y

# LSM security hooks (for kernel >= 4.2, uses lsm_hooks_list.c)
CONFIG_KSU_LSM_SECURITY_HOOKS=y

# SU logging
CONFIG_KSU_FEATURE_SULOG=y

# ADB root feature
CONFIG_KSU_FEATURE_ADBROOT=y

# Kprobe dependencies (required by KSU_KPROBES_KSUD)
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KRETPROBES=y

# Required by KSU syscall_table_hook (kallsyms_lookup_name)
CONFIG_KALLSYMS=y

# =====================================================
# DroidSpaces - Namespaces
# =====================================================
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# =====================================================
# DroidSpaces - Seccomp (auto-selected by KSU, but ensure)
# =====================================================
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# =====================================================
# DroidSpaces - Cgroups
# =====================================================
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# =====================================================
# DroidSpaces - IPC
# =====================================================
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# =====================================================
# DroidSpaces - Filesystem
# =====================================================
CONFIG_DEVTMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y

# =====================================================
# DroidSpaces - Networking (NAT/None modes)
# =====================================================
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_TABLES=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# Disable Android paranoid network (required for container internet)
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# =====================================================
# DroidSpaces - Firewall (UFW/Fail2ban)
# =====================================================
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_TARGET_ULOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# =====================================================
# Docker Full Feature Support
# =====================================================
# User namespaces (rootless Docker)
CONFIG_USER_NS=y

# IP Virtual Server (Docker Swarm / Docker overlay networking)
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y

# IPsec / XFRM (Docker overlay encryption)
CONFIG_XFRM_USER=y
CONFIG_XFRM_ALGO=y

# Network cgroup classification
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NET_CLS_CGROUP=y

# iptables redirect (Docker port mapping)
CONFIG_IP_NF_TARGET_REDIRECT=y

# Checkpoint/restore (CRIU, docker checkpoint)
CONFIG_CHECKPOINT_RESTORE=y

# Ext4 filesystem (Docker image layers)
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
